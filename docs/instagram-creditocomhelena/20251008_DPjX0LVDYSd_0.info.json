{"id": "DPjX0LVDYSd", "title": "Video by creditocomhelena", "description": "Enquanto muita gente trava por falta de capital, algumas empresas estão conseguindo investir com carência de meses, juros menores e garantia do próprio BNDES.\nEssa linha se chama FGI — e ela pode ser o que estava faltando pra sua empresa sair do aperto e ganhar fôlego pra expandir.\n\nEu te mostro na prática como funciona, quais bancos operam e como usar o faturamento da sua empresa pra conseguir aprovação com segurança.\n\n#CréditoInteligente #FGI #BNDES #CréditoEmpresarial #CapitalDeGiro #EmpreenderComEstratégia #ConsultoriaFinanceira #MeraktosConsultoria #HelenaEspecialista", "channel": "creditocomhelena", "uploader_id": "74296635032", "uploader": "Crédito com Helena | Meraktos Consultoria", "timestamp": 1759936058, "like_count": 24, "comment_count": 8, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-1336576784788012a", "ext": "m4a", "tbr": 81.46, "asr": 44100, "format_note": "DASH audio", "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "url": "https://instagram.fsjk2-1.fna.fbcdn.net/o1/v/t16/f2/m69/AQNl60n1fjpJMwozp2DZED7fegIuXEGNPO7F49wh55pzH2m4wDV79v43cXPK8W7JG5tsxNi5-U6JTWoHCyfhKYHg.mp4?strext=1&_nc_cat=106&_nc_oc=AdqKXcKtmHCxb_q8KqDEtGDoYg7hkacj_O4I_uv-9EQKcVqMMFtFnqySqWPhHNds0SM3gHmpIlqUU_WlyzHdu_q7&_nc_sid=9ca052&_nc_ht=instagram.fsjk2-1.fna.fbcdn.net&_nc_ohc=PBJpFJ5opGkQ7kNvwHzUyBe&%3D&ccb=17-1&_nc_gid=wQsYz8evusAoCwdSld59dg&_nc_ss=7a22e&_nc_map=urlgen_bucketless&_nc_zt=28&oh=00_AQT-MCTfAJMFX0z2vMUpahmPuHPzG_mJKyj9qkck1yfR0Q&oe=6AFD6296", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none",